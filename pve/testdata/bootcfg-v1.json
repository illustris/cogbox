{
  "schema": "cogworx-pve-bootcfg-v1-vectors",
  "notes": [
    "Shared byte-for-byte by the cogbox emulator (pve/metadata/cogworx_pve_metadata.py) and the cogworx Go encoder/decoder; the decode rules and reject reasons are documented in the emulator's module docstring.",
    "bootconfig != null: an encode vector. Encoding bootconfig with owner_uuid must reproduce serial_blob and smbios1 exactly (keys sorted by byte value, form-encoded with quote_plus / url.Values.Encode, v=1 always present, absent/false/empty fields omitted, maintenance=true as M=).",
    "bootconfig == null: a decode-only vector (the blob is not something the encoder emits).",
    "Every vector: decoding smbios1 (or serial_blob, in either the raw or the standard-base64 SMBIOS serial form) yields expect_attrs, or rejects the whole blob with expect_reject.",
    "An empty serial_blob is NO blob (the Provision-time owner-only smbios1), not a rejection.",
    "All values are fictional. The worst case uses 255.255.255.255 and a nine-digit VMID only because they are the longest values the grammars admit."
  ],
  "smbios1_max_len": 512,
  "attributes": {
    "K": "cogworx-ssh-ca-pub",
    "M": "cogworx-maintenance",
    "c": "cogworx-vcpu",
    "g": "cogworx-guest-resolver",
    "h": "cogworx-hostname",
    "i": "cogworx-instance",
    "m": "cogworx-mem-mb",
    "n": "cogworx-start-nonce",
    "p": "cogworx-ssh-principal",
    "w": "cogworx-network"
  },
  "bootconfig_fields": {
    "nonce": "n",
    "instance": "i",
    "principal": "p",
    "ssh_ca_pub": "K",
    "hostname": "h",
    "vcpu": "c",
    "mem_mb": "m",
    "network": "w",
    "guest_resolver": "g",
    "maintenance": "M"
  },
  "reject_reasons": [
    "parse-error",
    "too-many-fields",
    "duplicate-key",
    "missing-version",
    "bad-version",
    "invalid-value:K",
    "invalid-value:M",
    "invalid-value:c",
    "invalid-value:g",
    "invalid-value:h",
    "invalid-value:i",
    "invalid-value:m",
    "invalid-value:n",
    "invalid-value:p",
    "invalid-value:w"
  ],
